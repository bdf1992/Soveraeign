# Copy to .env for local use. Never place credentials in this example.

# Local node storage. Keep the example path repository-relative.
SOVERAEIGN_STATE_DIR=.local/soveraeign

# Optional model binding identity. The binding resolves credentials indirectly.
SOVERAEIGN_MODEL_BINDING=
SOVERAEIGN_CREDENTIAL_REF=

# Optional remote model endpoint. Remote use still requires a declared binding,
# data-boundary mode, scoped authority, input projection, and receipt.
SOVERAEIGN_REMOTE_MODEL_ENDPOINT=
