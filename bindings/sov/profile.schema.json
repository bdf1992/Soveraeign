{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/bindings/sov/profile.schema.json",
  "title": "Sov context profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "profile_kind",
    "profile_status",
    "entrypoint",
    "portable",
    "default_effect_ceiling",
    "governing_sources",
    "minimum_context",
    "context_selection",
    "authority",
    "state",
    "agency",
    "session_declaration_schema",
    "activation_gates",
    "dynamic_context_gate",
    "fallback_policy"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "profile_id": {"const": "sov"},
    "display_name": {"const": "Sov"},
    "profile_kind": {"const": "MODEL_CONTEXT_PROFILE"},
    "profile_status": {"const": "BUILT_SELF_TESTED_NOT_WITNESSED"},
    "entrypoint": {"const": "SOV.md"},
    "portable": {"const": true},
    "default_effect_ceiling": {"const": "REQUEST_ONLY"},
    "governing_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "minimum_context": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "context_selection": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granted_by_profile", "source"],
      "properties": {
        "granted_by_profile": {"const": false},
        "source": {"const": "LIVE_TYPED_GRANT_AT_OPERATION_BOUNDARY"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns_authoritative_state",
        "allows_private_durable_state",
        "durable_sources"
      ],
      "properties": {
        "owns_authoritative_state": {"const": false},
        "allows_private_durable_state": {"const": false},
        "durable_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may", "may_not"],
      "properties": {
        "may": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "may_not": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "session_declaration_schema": {"type": "string", "minLength": 1},
    "activation_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^issue:[0-9]+$"}
    },
    "dynamic_context_gate": {"type": "string", "pattern": "^issue:[0-9]+$"},
    "fallback_policy": {"const": "NONE"}
  }
}

