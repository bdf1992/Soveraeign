{
  "corpus_id": "soveraeign-ticket-transition-cases/v1",
  "note": "Positive and defeating cases for contracts/ticket-transitions.json. Every refusal code the table declares has at least one case proving the refusal actually fires. A case may not be weakened to admit a participant; a confirmed Red finding is added here permanently.",
  "cases": [
    {
      "case_id": "TC-001-draft-a-ticket",
      "expect": "ALLOWED",
      "proves": "A drafted ticket carrying its obligation, priors, and closure contract may reach PROPOSED.",
      "request": {
        "request_schema": "soveraeign-ticket-transition/v1",
        "ticket": "#25",
        "from": "OPEN",
        "to": "PROPOSED",
        "actor_id": "model/orchestrator",
        "actor_kind": "MODEL",
        "reason": "ticket drafted with a closure contract",
        "effect_class": "RECORD_LOCAL",
        "evidence": {
          "obligation": "#25#obligation",
          "priors": "CONTRACT.md",
          "closure_contract": "#25#closure-contract"
        }
      }
    },
    {
      "case_id": "TC-002-build-establishes-built-only",
      "expect": "ALLOWED",
      "proves": "A passing Blue lane advances a chartered ticket to BUILT and no further.",
      "request": {
        "request_schema": "soveraeign-ticket-transition/v1",
        "ticket": "#28",
        "from": "CHARTERED_NOT_IMPLEMENTED",
        "to": "BUILT_SELF_TESTED_NOT_WITNESSED",
        "actor_id": "model/worker-a",
        "actor_kind": "WORKER",
        "reason": "closure contract satisfied and repository verification passed",
        "effect_class": "RECORD_LOCAL",
        "evidence": {
          "closure_contract_complete": "#28#closure-contract",
          "blue_receipt": "receipt/blue/0001"
        }
      }
    },
    {
      "case_id": "TC-003-independent-witness-with-settled-purple",
      "expect": "ALLOWED",
      "proves": "An independent witness plus a converged Red engagement combines to PURPLE and earns WITNESSED.",
      "request": {
        "request_schema": "soveraeign-ticket-transition/v1",
        "ticket": "#27",
        "from": "BUILT_SELF_TESTED_NOT_WITNESSED",
        "to": "WITNESSED",
        "actor_id": "model/witness-b",
        "actor_kind": "MODEL",
        "builder_actor_id": "model/worker-a",
        "reason": "independent observation reproduced the claimed behaviour",
        "effect_class": "RECORD_LOCAL",
        "evidence": {
          "witness_receipt": "receipt/witness/0007",
          "purple_receipt": "receipt/purple/0007"
        },
        "purple_receipt": {
          "blue_receipt": "receipt/blue/0007",
          "red_operator_actor_id": "model/red-c",
          "rounds": 3,
          "dry_rounds": 2,
          "required_dry_rounds": 2,
          "findings": [
            {
              "finding_id": "RED-27-001",
              "status": "CONFIRMED",
              "summary": "refusal bypass on an unmanaged root",
              "fixture_pointer": "conformance/fixtures/tickets/RED-27-001.json",
              "reproduced_by_actor_id": "model/witness-b"
            },
            {
              "finding_id": "RED-27-002",
              "status": "DISMISSED",
              "summary": "claimed provenance gap did not reproduce"
            }
          ]
        }
      }
    },
