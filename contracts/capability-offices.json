{
  "table_id": "soveraeign-capability-offices/v1",
  "governed_by": [
    "SYSTEM.md",
    "CLASSIFICATION.md",
    "SPEC.md",
    "AGENTS.md",
    "STATUS.yaml",
    ".claude/epic/offices.json"
  ],
  "note": "Where each declared service operation is met and what it costs. Office and counter names are the ones .claude/epic/offices.json already uses; no new vocabulary. This table is policy input to the capability map projection. It grants nothing: required_authority names the grant an operation needs, never one it holds.",
  "phase": "FOUNDING",
  "counters": {
    "FRONT": {
      "operator-desk": "A human or model operator working inside the node.",
      "door": "Ingress and egress for anything outside the node.",
      "model-counter": "Bringing a model or an enterprise system in as an operator.",
      "job-window": "Asking for work to be done and collecting the result.",
      "review-desk": "Version-pinned review, annotation, and decision.",
      "drafting-window": "Composing a governed artifact before it is proposed."
    },
    "BACK": {
      "record": "The append-preserving journal and the projections rebuilt from it.",
      "permits-office": "Identity, authority, gates, registry, and the capability broker.",
      "inspectorate": "Independent observation, conformance, and fidelity.",
      "ground": "Local infrastructure and deployment custody.",
      "pattern-room": "Retrieval machinery: collections, indexes, and builds.",
      "beyond-the-node": "The federation horizon. Locked in Phase I."
    }
  },
  "transport_policy": {
    "IN_PROCESS": {
      "operator_facing": false,
      "external": false,
      "note": "A direct call inside one process. No transport of its own."
    },
    "CLI": {
      "operator_facing": false,
      "external": false,
      "note": "A local command on the same machine and the same filesystem."
    },
    "MCP": {
      "operator_facing": true,
      "external": false,
      "note": "Local stdio tool surface for a model operator. A transport, never a second authority path (adapters/github/README.md)."
    },
    "HTTP": {
      "operator_facing": true,
      "external": true,
      "note": "Network ingress. Refused while no_external_effects_in_phase_i stands."
    }
  },
  "external_transports_refused_in_phase": [
    "HTTP"
  ],
  "cli_commands": {
