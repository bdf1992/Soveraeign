{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/contracts/environment-pattern.schema.json",
  "title": "Soveraeign Environment Pattern v1",
  "description": "Definitions of allowed environment instances, delivery lineages, promotion crossings and history selectors. Names are user data and confer no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "environment_definitions", "trunk_definitions", "selectors"],
  "properties": {
    "schema": {"const": "soveraeign-environment-pattern/v1"},
    "id": {"type": "string", "minLength": 1},
    "environment_definitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "multiplicity", "acceptance", "required_authority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "multiplicity": {"enum": ["ONE", "MANY"]},
          "acceptance": {"enum": ["NONE", "EXPLICIT"]},
          "required_authority": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "trunk_definitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "crossings"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "crossings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["from", "to", "serialization", "evidence"],
              "properties": {
                "from": {"type": "string"}, "to": {"type": "string"},
                "serialization": {"enum": ["NONE", "INTEGRATION"]},
                "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "environment", "offset"],
        "properties": {
          "kind": {"const": "ACCEPTED_HISTORY"},
          "environment": {"type": "string"},
          "offset": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
