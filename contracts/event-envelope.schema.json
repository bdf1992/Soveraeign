{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/contracts/event-envelope.schema.json",
  "title": "Soveraeign Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "operation_id",
    "event_phase",
    "actor_id",
    "actor_kind",
    "reason",
    "occurred_at",
    "inputs",
    "outputs",
    "authority_grant_ids",
    "effect_class",
    "outcome",
    "receipt_id"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "event_phase": {
      "enum": ["ATTEMPTED", "REPORTED", "OBSERVED", "SETTLED", "COUNTERED"]
    },
    "actor_id": {"type": "string", "minLength": 1},
    "actor_kind": {"enum": ["HUMAN", "MODEL", "WORKER", "SYSTEM"]},
    "reason": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/addressedValue"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/addressedValue"}
    },
    "authority_grant_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "effect_class": {
      "enum": ["RECORD_LOCAL", "RESOURCE_CONSUMPTION", "EXTERNAL_WORLD"]
    },
    "outcome": {
      "enum": ["ATTEMPTED", "COMMITTED", "FAILED", "REFUSED", "COUNTERED", "UNRESOLVED"]
    },
    "receipt_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "addressedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "digest"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1}
      }
    }
  }
}
