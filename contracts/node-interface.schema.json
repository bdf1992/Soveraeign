{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/contracts/node-interface.schema.json",
  "title": "Soveraeign Node Interface (PROPOSED)",
  "description": "A discardable read projection joining Node identity and local Root, Kernel closure, capability policy, exact route census, and admitted observations. Declared, bound, policy-active, reachable, and observed are independent facts. ACTION, READ, INSPECT, HARNESS, and NONE are derived presentation semantics, never standing or authority. This interface grants no authority, opens no route, settles nothing, and cannot promote its own standing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface_schema",
    "status",
    "node",
    "kernel",
    "derived_from",
    "source_digests",
    "input_state_digest",
    "counts",
    "seams",
    "omissions",
    "operations"
  ],
  "properties": {
    "interface_schema": {"const": "soveraeign-node-interface/v1"},
    "status": {"const": "PROPOSED"},
    "node": {"$ref": "#/$defs/node"},
    "kernel": {"$ref": "#/$defs/kernel"},
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "input_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {"$ref": "#/$defs/counts"},
    "seams": {"$ref": "#/$defs/seams"},
    "omissions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/omission"}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "digest"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "display_name", "root_seat", "node_source", "root_source",
        "node_source_digest", "root_source_digest"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^node:[a-z0-9][a-z0-9-]*$"},
        "display_name": {"type": "string", "minLength": 1},
        "root_seat": {"type": "string", "pattern": "^seat:[a-z0-9][a-z0-9-]*$"},
        "node_source": {"type": "string", "minLength": 1},
        "root_source": {"type": "string", "minLength": 1},
        "node_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closure_schema", "closure_input_state_digest", "paradigms", "participants"],
      "properties": {
        "closure_schema": {"const": "soveraeign-kernel-closure/v1"},
        "closure_input_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "paradigms": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "participants": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "bound", "policy_active", "reachable", "observed"],
      "properties": {
        "declared": {"type": "integer", "minimum": 0},
        "bound": {"type": "integer", "minimum": 0},
        "policy_active": {"type": "integer", "minimum": 0},
        "reachable": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0}
      }
    },
    "seams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "built_not_reachable", "policy_active_not_reachable",
        "reachable_not_observed", "unmapped_kernel_transition"
      ],
      "properties": {
        "built_not_reachable": {"$ref": "#/$defs/operationIds"},
        "policy_active_not_reachable": {"$ref": "#/$defs/operationIds"},
        "reachable_not_observed": {"$ref": "#/$defs/operationIds"},
        "unmapped_kernel_transition": {"$ref": "#/$defs/operationIds"}
      }
    },
    "operationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9-]*$"}
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "bound", "policy_active", "reachable", "observed"],
      "properties": {
        "declared": {"type": "boolean"},
        "bound": {"type": "boolean"},
        "policy_active": {"type": "boolean"},
        "reachable": {"type": "boolean"},
        "observed": {"type": "boolean"}
      }
    },
    "policyEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "activation"],
      "properties": {
        "transport": {"enum": ["IN_PROCESS", "CLI", "MCP", "HTTP"]},
        "activation": {"enum": ["ACTIVE", "DECLARED_NOT_ACTIVATED", "REFUSED_UNCONFIGURED"]},
        "address": {"type": "string", "minLength": 1},
        "refusal_code": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport", "address", "policy_active", "required_arguments",
        "optional_arguments", "source_addresses"
      ],
      "properties": {
        "transport": {"enum": ["IN_PROCESS", "CLI", "MCP", "HTTP"]},
        "address": {"type": "string", "minLength": 1},
        "policy_active": {"type": "boolean"},
        "required_arguments": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "optional_arguments": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_addresses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id", "service_id", "operation", "logical_endpoint", "standing",
        "subject", "crud", "commit", "kernel_paradigms", "kernel_transition",
        "required_authority", "effect_class", "actor_kinds", "preconditions",
        "refusals", "legal_choices", "policy_endpoints", "reachability", "affordance",
        "observation_ids", "facts", "sources", "record_digest"
      ],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9-]*$"},
        "service_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "logical_endpoint": {"type": "string", "pattern": "^sov://[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"},
        "standing": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "crud": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "kernel_paradigms": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "kernel_transition": {"type": ["string", "null"], "minLength": 1},
        "required_authority": {"type": "string", "minLength": 1},
        "effect_class": {"enum": ["RECORD_LOCAL", "RESOURCE_CONSUMPTION", "EXTERNAL_WORLD"]},
        "actor_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["HUMAN", "MODEL", "WORKER", "SYSTEM"]}
        },
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "refusals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "legal_choices": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "policy_endpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policyEndpoint"}},
        "reachability": {"type": "array", "items": {"$ref": "#/$defs/route"}},
        "affordance": {"$ref": "#/$defs/affordance"},
        "observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "facts": {"$ref": "#/$defs/facts"},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "affordance": {
      "type": "object",
      "description": "Derived UI semantics. ACTION and READ require an exact policy-active route. INSPECT exposes declared topology without implying execution. HARNESS is reserved for explicitly identified host plumbing and may never stand in for governed service state. NONE exposes no gesture. Editing this value changes neither policy nor reachability.",
      "additionalProperties": false,
      "required": ["kind", "reason_code", "explanation"],
      "properties": {
        "kind": {"enum": ["ACTION", "READ", "INSPECT", "HARNESS", "NONE"]},
        "reason_code": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "explanation"],
      "properties": {
        "code": {
          "enum": [
            "OBJECT_INSTANCES_NOT_PROJECTED",
            "MODEL_BINDINGS_NOT_PROJECTED",
            "HARNESS_STATE_NOT_PROJECTED"
          ]
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    }
  }
}
