{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/contracts/node-object-record.schema.json",
  "title": "Soveraeign Node Object Record (PROPOSED)",
  "description": "A read-only, source-addressed object projection returned by a governed Node read. It names the service-owned identity, exact journal sources, current revision, known relations, and receipts without granting authority or claiming the projection is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "object_kind",
    "source",
    "revision",
    "relations",
    "receipt_refs",
    "data"
  ],
  "properties": {
    "schema_version": {"const": "soveraeign-node-object-record/v1"},
    "object_id": {"type": "string", "minLength": 1},
    "object_kind": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "projection",
        "projection_authoritative",
        "snapshot_digest",
        "records"
      ],
      "properties": {
        "service_id": {"type": "string", "minLength": 1},
        "projection": {"type": "string", "minLength": 1},
        "projection_authoritative": {"const": false},
        "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRecord"}
        }
      }
    },
    "revision": {"$ref": "#/$defs/addressedRecord"},
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "receipt_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "data": {"type": "object"}
  },
  "$defs": {
    "addressedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "digest"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "digest", "role"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "target_id"],
      "properties": {
        "relation": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "target_address": {"type": ["string", "null"]},
        "target_digest": {
          "type": ["string", "null"],
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        }
      }
    }
  }
}
