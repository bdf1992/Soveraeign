{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/contracts/receipt.schema.json",
  "title": "Soveraeign Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "event_id", "event_type", "actor_id", "interface_id", "input_addresses", "input_state_digest", "authority_grant_ids", "precondition_results", "effect_class", "outcome", "emitted_record_addresses", "observed_evidence_addresses", "created_at", "receipt_digest"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "interface_id": {"type": "string", "minLength": 1},
    "input_addresses": {"type": "array", "items": {"type": "string"}},
    "input_state_digest": {"type": "string", "minLength": 1},
    "authority_grant_ids": {"type": "array", "items": {"type": "string"}},
    "precondition_results": {"type": "array", "items": {"type": "object"}},
    "effect_class": {"enum": ["RECORD_LOCAL", "RESOURCE_CONSUMPTION", "EXTERNAL_WORLD"]},
    "outcome": {"enum": ["COMMITTED", "FAILED", "REFUSED", "COUNTERED", "UNRESOLVED"]},
    "reason_code": {"type": ["string", "null"]},
    "emitted_record_addresses": {"type": "array", "items": {"type": "string"}},
    "observed_evidence_addresses": {"type": "array", "items": {"type": "string"}},
    "prior_receipt_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"enum": ["FAILED", "REFUSED", "UNRESOLVED"]}}}, "then": {"required": ["reason_code"], "properties": {"reason_code": {"type": "string", "minLength": 1}}}}
  ]
}
