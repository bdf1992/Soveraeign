{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soveraeign.local/contracts/channel.schema.json",
  "title": "Console Channel",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel_id", "name", "domain", "opened_by", "opened_at", "standing"],
  "properties": {
    "channel_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The domain or purpose the channel serves, e.g. asset, proofing, governance."},
    "opened_by": {"type": "string", "minLength": 1},
    "opened_at": {"type": "string", "format": "date-time"},
    "standing": {"enum": ["RECORDED", "ADMITTED", "RATIFIED", "EFFECTIVE"]}
  }
}
