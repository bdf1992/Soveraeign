  "depends_on": [
    "record:append-preserving-journal",
    "console:authority-grant",
    "observation:independent-observation",
    "automation:trigger-time",
    "runtime:leased-execution"
  ],
  "forbids": [
    "treating-os-credentials-as-soveraeign-authority",
    "arbitrary-shell-or-command-execution",
    "adapter-activated-policy",
    "bypassing-the-gateway-or-live-grant-check",
    "claiming-a-process-or-container-is-the-physical-host",
    "settling-an-external-effect-from-the-executor-report",
    "silent-privilege-escalation",
    "silent-platform-fallback"
  ],
  "note": "The governed operating-system boundary. The service owns host readings and requested host-work records; adapters translate to a named OS mechanism, Automation owns when scheduled work is requested, Runtime owns leased execution, and Observation owns evidence that an effect occurred. Registration and adapter capability grant nothing."
}
